reserves narrative flow", "Avoids timeline confusion", "Minimizes spoilers", "Reflects canon as accurately as possible"], ["\u041f\u043e\u043b\u043d\u044b\u0439 \u043e\u0445\u0432\u0430\u0442: \u0415\u0440\u0435\u0441\u044c \u0425\u043e\u0440\u0443\u0441\u0430 (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0432\u0441\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0430\u0440\u043a\u0438) \u041e\u0441\u0430\u0434\u0430 \u0422\u0435\u0440\u0440\u044b ( \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043d\u043e\u0432\u0435\u043b\u043b\u044b ) \u041f\u043e\u0441\u0442-\u0435\u0440\u0435\u0441\u044c (M31\u2013M32) \u042d\u0440\u0430 \u0417\u0432\u0435\u0440\u044f \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 40k (M41) \u042d\u0440\u0430 \u0418\u043d\u0434\u043e\u043c\u0438\u0442\u0443\u0441 (M42)", "\u0415\u0440\u0435\u0441\u044c \u0425\u043e\u0440\u0443\u0441\u0430 (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0432\u0441\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0430\u0440\u043a\u0438)", "\u041e\u0441\u0430\u0434\u0430 \u0422\u0435\u0440\u0440\u044b ( \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043d\u043e\u0432\u0435\u043b\u043b\u044b )", "\u041f\u043e\u0441\u0442-\u0435\u0440\u0435\u0441\u044c (M31\u2013M32)", "\u042d\u0440\u0430 \u0417\u0432\u0435\u0440\u044f", "\u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 40k (M41)", "\u042d\u0440\u0430 \u0418\u043d\u0434\u043e\u043c\u0438\u0442\u0443\u0441 (M42)", "\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442: \u0420\u043e\u043c\u0430\u043d\u044b \u041d\u043e\u0432\u0435\u043b\u043b\u044b \u0420\u0430\u0441\u0441\u043a\u0430\u0437\u044b \u0410\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0438", "\u0420\u043e\u043c\u0430\u043d\u044b", "\u041d\u043e\u0432\u0435\u043b\u043b\u044b", "\u0420\u0430\u0441\u0441\u043a\u0430\u0437\u044b", "\u0410\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0438", "\u0414\u043b\u0438\u043d\u043d\u044b\u0435 \u0441\u0435\u0440\u0438\u0438 \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b \u0432 \u0442\u043e\u0447\u043d\u044b\u0439 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0447\u0442\u0435\u043d\u0438\u044f", "\u0425\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u0441\u0442\u0440\u043e\u0433\u043e \u043f\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u043c \u0432 \u043b\u043e\u0440\u0435", "\u041d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0432\u044b\u0440\u0435\u0437\u0430\u043d\u043e (\u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b \u0438 \u043d\u043e\u0432\u0435\u043b\u043b\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b)", "\u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u044b: \u0425\u0430\u043e\u0441 \u041a\u0441\u0435\u043d\u043e\u0441\u044b", "\u0425\u0430\u043e\u0441", "\u041a\u0441\u0435\u043d\u043e\u0441\u044b", "\u041e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0431\u043b\u043e\u043a\u0438 \u0434\u043b\u044f: \u041d\u0435\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u0442\u0430\u0439\u043c\u043b\u0430\u0439\u043d\u043e\u0432 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0435\u043a\u0440\u043e\u043d\u044b) \u0421\u043b\u0430\u0431\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0444\u0440\u0430\u043a\u0446\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u0430\u0443)", "\u041d\u0435\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u0442\u0430\u0439\u043c\u043b\u0430\u0439\u043d\u043e\u0432 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0435\u043a\u0440\u043e\u043d\u044b)", "\u0421\u043b\u0430\u0431\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0444\u0440\u0430\u043a\u0446\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u0430\u0443)", "\u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u044b \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0440\u0443\u0441\u0441\u043a\u0438\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f", "\u0414\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0435\u0441\u0442\u044c \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435"], ["\u0415\u0440\u0435\u0441\u044c \u0425\u043e\u0440\u0443\u0441\u0430 (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0432\u0441\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0430\u0440\u043a\u0438)", "\u041e\u0441\u0430\u0434\u0430 \u0422\u0435\u0440\u0440\u044b ( \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043d\u043e\u0432\u0435\u043b\u043b\u044b )", "\u041f\u043e\u0441\u0442-\u0435\u0440\u0435\u0441\u044c (M31\u2013M32)", "\u042d\u0440\u0430 \u0417\u0432\u0435\u0440\u044f", "\u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 40k (M41)", "\u042d\u0440\u0430 \u0418\u043d\u0434\u043e\u043c\u0438\u0442\u0443\u0441 (M42)"], ["\u0420\u043e\u043c\u0430\u043d\u044b", "\u041d\u043e\u0432\u0435\u043b\u043b\u044b", "\u0420\u0430\u0441\u0441\u043a\u0430\u0437\u044b", "\u0410\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0438"], ["\u0425\u0430\u043e\u0441", "\u041a\u0441\u0435\u043d\u043e\u0441\u044b"], ["\u041d\u0435\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u0442\u0430\u0439\u043c\u043b\u0430\u0439\u043d\u043e\u0432 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0435\u043a\u0440\u043e\u043d\u044b)", "\u0421\u043b\u0430\u0431\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0444\u0440\u0430\u043a\u0446\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u0430\u0443)"], ["\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 (EN)", "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 (RU, \u0435\u0441\u043b\u0438 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435)", "\u0421\u0435\u0440\u0438\u044f / \u0430\u0440\u043a\u0430", "\u041f\u043e\u0437\u0438\u0446\u0438\u044f \u0432 \u0442\u0430\u0439\u043c\u043b\u0430\u0439\u043d\u0435 (M30\u2013M42)", "\u0424\u0440\u0430\u043a\u0446\u0438\u044f (\u0435\u0441\u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u043e)", "\u0422\u0438\u043f (\u0440\u043e\u043c\u0430\u043d / \u043d\u043e\u0432\u0435\u043b\u043b\u0430 / \u0440\u0430\u0441\u0441\u043a\u0430\u0437 / \u0430\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u044f)", "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435"], ["\u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0430\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043d\u0435\u043a\u0440\u043e\u043d\u044b) \u0438\u043c\u0435\u044e\u0442 \u0443\u0441\u043b\u043e\u0432\u043d\u0443\u044e \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044e", "\u041a\u043e\u0434\u0435\u043a\u0441\u044b, \u043a\u0430\u043c\u043f\u0435\u0439\u043d-\u043a\u043d\u0438\u0433\u0438 \u0438 \u0430\u0440\u0442\u0431\u0443\u043a\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u044b", "\u0420\u0443\u0441\u0441\u043a\u0438\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430"], ["\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0446\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u0432\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f", "\u041c\u0438\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u0441\u043f\u043e\u0439\u043b\u0435\u0440\u044b", "\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0442\u043e\u0447\u043d\u043e \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u043a\u0430\u043d\u043e\u043d"], ["Terms", "Privacy", "Security", "Status", "Community", "Docs", "Contact", "Manage cookies", "Do not share my personal information"]], "tables": [[["Name", "Name", "Last commit message", "Last commit date"], ["Latest commit History 9 Commits 9 Commits"], [".gitattributes", ".gitattributes", "", ""], ["README.md", "README.md", "", ""], ["warhammer_40k_chronology_audited_v4.xlsx", "warhammer_40k_chronology_audited_v4.xlsx", "", ""], ["View all files"]]], "code_blocks": ["warhammer_40k_chronology_ru_desc_filled_v3.xlsx", "warhammer_40k_chronology_ru_desc_filled_v3.xlsx"], "meta_description": "Complete chronological list of Warhammer 40,000 (Black Library) works by in-universe events, not release date. Includes novels, novellas, short stories, and anthologies. Series are expanded into correct order. Russian titles (if official) and brief descriptions included. - king-of-cats/Warhammer-40k", "meta_keywords": "", "og_image": "https://opengraph.githubassets.com/0144e711b7d7ee062b8b434a83b254d8d560f22c3b45b03d5a5209d34cfc7909/king-of-cats/Warhammer-40k", "js_rendered": true, "js_message": "Page appears to be rendered by a JavaScript framework; content may be incomplete.", "success": true, "error": "", "truncated": false, "fetched_bytes": 285565, "total_bytes": 285565}}