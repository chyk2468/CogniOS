sts", "Interviews", "Community"], ["Sign in", "Newsletter"], ["", "", "", "", "", "", "", "", ""], ["Lists", "Comics", "marvel comics"], ["Youtube", "Facebook", "Instagram", "Twitter", "Tiktok", "Linkedin"], ["Join Our Team", "Our Audience", "About Us", "Press & Events", "Media Coverage", "Subscribe to Premium"], ["Contact Us", "Careers", "Advertising", "Have a News Tip?"], ["Terms", "Privacy", "Policies"], ["Movies", "TV", "Comics", "Anime", "Games", "Videos"], ["Join Our Team", "Our Audience", "About Us", "Press & Events", "Media Coverage", "Subscribe to Premium"], [""], ["Contact Us", "Careers", "Advertising", "Have a News Tip?"], ["Terms", "Privacy", "Policies"]], "tables": [], "code_blocks": [], "meta_description": "Though they started later than DC, Marvel Comics' Silver Age is more memorable. It introduced flawed heroes and villains.", "meta_keywords": "", "og_image": "https://static0.cbrimages.com/wordpress/wp-content/uploads/2021/03/marvel-first-silver-age-comics-chronological-order.png?w=1200&h=675&fit=crop", "js_rendered": true, "js_message": "Page appears to be rendered by a JavaScript framework; content may be incomplete.", "success": true, "error": "", "truncated": false, "fetched_bytes": 276002, "total_bytes": 276002}}