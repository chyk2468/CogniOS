uperhero", "TV Anime Cartoons Action and Adventure Comedy Documentary Drama Fantasy History Horror Thriller Science Fiction Superhero", "Anime", "Cartoons", "Action and Adventure", "Comedy", "Documentary", "Drama", "Fantasy", "History", "Horror", "Thriller", "Science Fiction", "Superhero", "TRAILERS", "REVIEWS Movie Reviews TV Reviews", "Movie Reviews", "TV Reviews", "EXCLUSIVES Interviews Opinion", "Interviews", "Opinion", "FEATURES"], ["Movie News", "TV News"], ["Action and Adventure", "Animation", "Comedy", "Documentary", "Drama", "Fantasy", "History", "Horror", "Thriller", "Romance", "Science Fiction", "Superhero"], ["Anime", "Cartoons", "Action and Adventure", "Comedy", "Documentary", "Drama", "Fantasy", "History", "Horror", "Thriller", "Science Fiction", "Superhero"], ["Movie Reviews", "TV Reviews"], ["Interviews", "Opinion"], ["", "", "", "", "", "", "", "Newsletter"], ["About", "Editorial Policies", "No-AI Writing Policy", "Reviews Policy", "Archive", "Privacy Policy", "Terms of Use"], ["", "", "", "", "", "", "", "Newsletter"], ["Movies", "Superhero Movies"]], "tables": [], "code_blocks": [], "meta_description": "Quite a talent you have there, Pyro. Here's what you should know about the fire-manipulating X-Men character before he appears in Marvel's Deadpool & Wolverine.", "meta_keywords": "", "og_image": "https://www.slashfilm.com/img/gallery/everything-to-know-about-x-mens-pyro-and-his-marvel-history/l-intro-1713189559.jpg", "js_rendered": true, "js_message": "Page appears to be rendered by a JavaScript framework; content may be incomplete.", "success": true, "error": "", "truncated": false, "fetched_bytes": 63661, "total_bytes": 63661}}