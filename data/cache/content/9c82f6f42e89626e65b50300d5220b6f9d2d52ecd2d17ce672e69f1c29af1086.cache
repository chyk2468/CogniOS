{"timestamp": "2026-07-28T10:09:33.726151", "data": {"url": "https://www.tiktok.com/discover/ratan-tata-business-companies", "title": "TikTok", "content": "TikTok Watch now Dear Users, On June 29, 2020 the Govt. of India decided to block 59 apps, including TikTok. We are in the process of complying with the Government of India's directive and also working with the government to better understand the issue and explore a course of action. Ensuring the privacy and security of all our users in India remains our utmost priority. TikTok India Team. Follow us on Twitter and Instagram . Term of Use Copyright Policy Privacy Policy", "lists": [], "tables": [], "code_blocks": [], "meta_description": "TikTok", "meta_keywords": "", "og_image": "", "js_rendered": true, "js_message": "Page appears to be rendered by a JavaScript framework; content may be incomplete.", "success": true, "error": "", "truncated": false, "fetched_bytes": 106021, "total_bytes": 106021}}